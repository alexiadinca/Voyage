# Copy to backend/.env (setup.py does this automatically) and fill in the values.
# backend/.env is git-ignored – NEVER commit real keys.

ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# Supabase -> Project Settings -> API / Database
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
DATABASE_URL=postgresql+psycopg://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# OpenAI (conversational assistant – called only from the backend)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=

# External data services
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
WEATHER_RAIN_THRESHOLD=60

# ML model artifact (relative to backend/)
MODEL_ARTIFACT_PATH=../ml/artifacts/destination_ranker.joblib
