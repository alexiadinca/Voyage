# Copy to .env.local (setup.py does this automatically) and fill in the values.
# Only PUBLIC values go here: everything prefixed NEXT_PUBLIC_ is shipped to the browser.
# Never put the Supabase service-role key or the OpenAI key in this file.

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# FastAPI backend (local default)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Map tiles (OpenStreetMap default; attribution must stay visible on the map)
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
